# ── Aplikasi ─────────────────────────────────────────────────
# true = aktifkan log debug di terminal
APP_DEBUG=true
# Port server web
APP_PORT=3001

# ── Stream ────────────────────────────────────────────────────
# URL RTSP sumber video
STREAM_URL=rtsp://localhost:8554/cctv

# ── Deteksi ───────────────────────────────────────────────────
# Ambang batas kepercayaan deteksi (0.0–1.0, lebih tinggi = lebih ketat)
DETECT_CONF=0.35
# Maksimum frame per detik yang diproses YOLO
DETECT_MAX_FPS=5
# Resolusi inference YOLO (lebar, bukan resolusi sumber). Lebih kecil = lebih cepat. 0 = resolusi asli frame
DETECT_IMGSZ=0
# Maksimum frame per detik yang dikirim ke browser
STREAM_MAX_FPS=10
# Lebar MJPEG ke browser (px). Lebih kecil = lebih hemat bandwidth & CPU encode. 0 = resolusi asli
STREAM_WIDTH=0
# Nama file model di dalam folder models/
YOLO_MODEL=yolo11m.pt

# ── Zona ──────────────────────────────────────────────────────
# Jeda minimum antar alert per zona (detik)
GATE_ALERT_COOLDOWN=10
# Detik tanpa deteksi sebelum zona dianggap tidak aktif
GATE_DEACTIVATE_SEC=3

# ── Notifikasi (default awal, tersimpan ke DB setelah diubah via UI) ──
# Jeda minimum antar notifikasi Telegram (detik), contoh: 300 = 5 menit
NOTIF_INTERVAL=300
# Jumlah riwayat yang ditampilkan di UI awal
NOTIF_HISTORY_DISPLAY=5
# Maksimum riwayat notifikasi yang disimpan di DB (entri lama otomatis dihapus)
NOTIF_HISTORY_MAX=100
# Jenis notifikasi yang dikirim ke Telegram (default awal, bisa diubah via UI)
NOTIF_SEND_PHOTO=true
NOTIF_SEND_VIDEO=false
# Durasi klip video (detik) dan FPS buffer
NOTIF_VIDEO_DURATION=10
NOTIF_VIDEO_FPS=10
# true = abaikan jam aktif, kirim notifikasi kapan saja
NOTIF_ALWAYS_ON=false
# Jam mulai pengiriman notifikasi (format HH:MM), diabaikan jika NOTIF_ALWAYS_ON=true
NOTIF_TIME_START=00:00
# Jam akhir pengiriman notifikasi (format HH:MM), diabaikan jika NOTIF_ALWAYS_ON=true
NOTIF_TIME_END=23:59

# ── Rekaman ──────────────────────────────────────────────────
# Folder rekaman (SD dan 2K disimpan di subfolder sd/ dan 2k/)
RECORD_DIR=/home/serverku/live-stream-cw300/recordings
# Total batas ukuran gabungan SD+2K (GB). File terlama dihapus otomatis.
RECORD_MAX_GB=16

# ── Telegram ─────────────────────────────────────────────────
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAdummyTokenReplaceMe1234567890abc
# Chat ID tujuan notifikasi (gunakan @userinfobot untuk mendapatkan ID)
TELEGRAM_CHAT_ID=000000000
